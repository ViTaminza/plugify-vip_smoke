{
	"$schema": "https://raw.githubusercontent.com/untrustedmodders/plugify/refs/heads/main/schemas/plugin.schema.json",
	"version": "${VIP_SMOKE_VERSION}",
	"name": "vip_smoke",
	"description": "[VIP] Colored Smoke: colours the smoke grenades of VIPs whose 'smoke_color' feature holds an \"R G B\" value (or 'random'), by writing the projectile's m_vSmokeColor when it spawns. Ported from the Pisex VIP core module VIP_Smoke (vip_smoke). Requires the vip core.",
	"author": "Pisex, ported to Plugify",
	"website": "https://github.com/untrustedmodders/plugify",
	"license": "GPL-3.0",
	"entry": "bin/vip_smoke",
	"platforms": [],
	"language": "cpp",
	"dependencies": [
		{
			"name": "s2sdk",
			"constraints": ">=2.18.2"
		},
		{
			"name": "vip",
			"constraints": ">=1.0.0"
		},
		{
			"name": "hudmenu",
			"constraints": ">=1.0.0",
			"optional": true
		}
	]
}
